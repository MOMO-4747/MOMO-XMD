# MOMO-XMD Environment Variables
# Copy this file to .env and fill in your values

# Session ID (from pairing) - Format: MOMO-XMD_255712345678
# You get this from your WhatsApp inbox after completing pairing
SESSION_ID=

# Owner Number (without +)
OWNER_NUMBER=255760298574

# Bot Mode: private or public
MODE=private

# Command Prefix
PREFIX=.
